# Настройки деплоя панели на сервер
# Скопируйте в .env.deploy и заполните значения. Файл .env.deploy не коммитьте в git.

# Хост сервера (IP или домен)
SERVER_HOST=your-server.com

# Пользователь SSH
SERVER_USER=deploy

# Путь на сервере, куда загрузить содержимое папки dist (должен существовать)
SERVER_PATH=/var/www/harmony-panel
