# Переменные для ПАНЕЛИ (panel-harmony). Не путать с .env бэкенда (backend-harmony).
# Связка с бекендом и приложением: см. ENV-SETUP.md в корне репозитория.

# URL бэкенда: сюда панель шлёт запросы (логин, статистика, контент).
# Локально: VITE_API_URL=http://localhost:3000
# На сервере:
VITE_API_URL=https://api.harmonymeditation.online

# Обязательно для работы статистики и контента: скопируйте сюда значение APP_KEY из backend-harmony/.env (один и тот же ключ для панели и приложения). После изменения — пересобрать: npm run build
VITE_APP_KEY=
