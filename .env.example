# Переменные для ПАНЕЛИ (panel-harmony). Не путать с .env бэкенда (backend-harmony).

# URL бэкенда: сюда панель шлёт запросы (логин, статистика, контент).
# Локально:
#   VITE_API_URL=http://localhost:3000
# На сервере (ваш бэкенд):
VITE_API_URL=https://api.harmonymeditation.online

# Ключ приложения (должен совпадать с APP_KEY в .env бэкенда). Нужен для доступа к API.
# VITE_APP_KEY=harmony-local-app-key-min-8
